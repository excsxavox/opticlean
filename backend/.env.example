PORT=3011
NODE_ENV=production

# Obligatorio en producción: 32+ caracteres aleatorios (el servidor no arranca sin él).
OPTICLEAN_JWT_SECRET=cambia-este-secreto
OPTICLEAN_JWT_TTL=43200

# En producción no se crean usuarios demo. El administrador inicial sale de estas dos
# variables (contraseña de 12+ caracteres) si aún no existe un administrador activo.
OPTICLEAN_DEMO_PASSWORD=OptiClean2026!
OPTICLEAN_ADMIN_EMAIL=admin@innovamf.com
OPTICLEAN_ADMIN_PASSWORD=
OPTICLEAN_ADMIN_NAME=Administración
OPTICLEAN_BODEGA_EMAIL=bodega@innovamf.com
OPTICLEAN_BODEGA_PASSWORD=
OPTICLEAN_OPS_EMAIL=ops@innovamf.com
OPTICLEAN_OPS_PASSWORD=
OPTICLEAN_DISPATCH_EMAIL=despacho@innovamf.com
OPTICLEAN_DISPATCH_PASSWORD=
OPTICLEAN_DRIVER_EMAIL=conductor@innovamf.com
OPTICLEAN_DRIVER_PASSWORD=
OPTICLEAN_DRIVER_TRUCK=GBA-2041

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Datos y continuidad
# Carpeta de los archivos de estado (uno por empresa) y de backups/.
OPTICLEAN_DATA_DIR=
# Días de respaldo diario que se conservan.
OPTICLEAN_BACKUPS_KEPT=14
# 0 = la empresa por defecto empieza vacía en lugar de con datos demo.
OPTICLEAN_DEMO_DATA=1
# 1 = permite "Restablecer datos" en producción (no recomendado).
OPTICLEAN_ALLOW_RESET=0

# Registro público de empresas (/registro). En desarrollo está activo salvo 0; en producción solo con 1.
OPTICLEAN_SIGNUP_ENABLED=0

# Seguridad
# Dominios que pueden llamar al API desde el navegador (separados por coma).
# Vacío en producción = solo el mismo dominio (web, ops y admin pasan por nginx).
OPTICLEAN_CORS_ORIGINS=

# PostgreSQL para el estado de cada empresa. Sin esto se usan archivos JSON en OPTICLEAN_DATA_DIR.
# Migra los datos existentes con: npm run migrate:pg
DATABASE_URL=
# OPTICLEAN_PG_SSL=1
# OPTICLEAN_PG_POOL=10
